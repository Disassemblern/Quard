# The BI database from bi/compose.yaml
DATABASE_URL=postgres://quard:quard@localhost:5433/quard
# For webhook and control: openssl rand -hex 32
QUARD_HASH_KEY=
# Printed by db/cli/setup-main.ts in B3
QUARD_AGENT_KEY=
QUARD_WEBHOOK_URL=http://localhost:4100
QUARD_CONTROL_URL=http://localhost:4200
# The role Power BI signs in with
BI_READER_PASSWORD=
# pytest creates and drops its own databases on this server
TEST_DATABASE_URL=postgres://quard:quard@localhost:5433/postgres
# Optional, for the live checks in B6
LIVE_DATABASE_URL=postgres://quard:quard@localhost:5433/quard
