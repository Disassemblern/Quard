{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "kpi-card",
  "position": {
    "x": 24,
    "y": 104,
    "z": 4000,
    "height": 96,
    "width": 1232,
    "tabOrder": 4000
  },
  "visual": {
    "visualType": "cardVisual",
    "query": {
      "queryState": {
        "Data": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Failing checks"
                }
              },
              "queryRef": "_Measures.Failing checks",
              "nativeQueryRef": "Failing checks"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Runs gap vs source"
                }
              },
              "queryRef": "_Measures.Runs gap vs source",
              "nativeQueryRef": "Runs gap vs source"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Cost gap vs source"
                }
              },
              "queryRef": "_Measures.Cost gap vs source",
              "nativeQueryRef": "Cost gap vs source"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Last refresh"
                }
              },
              "queryRef": "_Measures.Last refresh",
              "nativeQueryRef": "Refreshed at",
              "displayName": "Refreshed at"
            }
          ]
        }
      }
    },
    "objects": {
      "layout": [
        {
          "properties": {
            "maxTiles": {
              "expr": {
                "Literal": {
                  "Value": "4L"
                }
              }
            }
          },
          "selector": {
            "id": "default"
          }
        }
      ]
    },
    "visualContainerObjects": {
      "general": [
        {
          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'Data quality headline numbers: failing checks, gaps against the source and the last refresh time.'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
