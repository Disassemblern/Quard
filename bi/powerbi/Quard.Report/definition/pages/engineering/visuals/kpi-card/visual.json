{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "kpi-card",
  "position": {
    "x": 24,
    "y": 104,
    "z": 4000,
    "height": 96,
    "width": 1232,
    "tabOrder": 4000
  },
  "visual": {
    "visualType": "cardVisual",
    "query": {
      "queryState": {
        "Data": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Model cost"
                }
              },
              "queryRef": "_Measures.Model cost",
              "nativeQueryRef": "Model cost"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Cost per run"
                }
              },
              "queryRef": "_Measures.Cost per run",
              "nativeQueryRef": "Cost per run"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Failure rate"
                }
              },
              "queryRef": "_Measures.Failure rate",
              "nativeQueryRef": "Failure rate"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Avg steps per run"
                }
              },
              "queryRef": "_Measures.Avg steps per run",
              "nativeQueryRef": "Avg steps per run"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Latency p95 ms"
                }
              },
              "queryRef": "_Measures.Latency p95 ms",
              "nativeQueryRef": "Latency p95 ms"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Cached token share"
                }
              },
              "queryRef": "_Measures.Cached token share",
              "nativeQueryRef": "Cached token share"
            }
          ]
        }
      }
    },
    "objects": {
      "layout": [
        {
          "properties": {
            "maxTiles": {
              "expr": {
                "Literal": {
                  "Value": "6L"
                }
              }
            }
          },
          "selector": {
            "id": "default"
          }
        }
      ]
    },
    "visualContainerObjects": {
      "general": [
        {
          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'Engineering headline numbers: model cost, cost per run, failure rate, steps, latency and cache use.'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}