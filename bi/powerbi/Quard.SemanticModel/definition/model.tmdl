model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","TMDLView_Desktop","DaxQueryView_Desktop"]

annotation PBI_QueryOrder = ["PgServer","PgDatabase","ProjectId","GetView","ColumnName","Runs","Model calls","Tool calls","Guard decisions","Incidents","Payments","Agent","Model","Tool","Guard","Data checks","Control totals","Date","_Measures"]

ref table Runs
ref table 'Model calls'
ref table 'Tool calls'
ref table 'Guard decisions'
ref table Incidents
ref table Payments
ref table Agent
ref table Model
ref table Tool
ref table Guard
ref table 'Data checks'
ref table 'Control totals'
ref table Date
ref table _Measures

ref cultureInfo en-US

