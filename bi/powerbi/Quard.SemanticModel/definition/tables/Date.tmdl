	partition Date = m
		mode: import
		source =
				let
				    First = List.Min(GetView("fact_run")[start_date]),
				    Last = #date(Date.Year(DateTimeZone.UtcNow()), 12, 31),
				    Days = List.Dates(First, Duration.Days(Last - First) + 1, #duration(1, 0, 0, 0)),
				    Base = Table.TransformColumnTypes(Table.FromList(Days, Splitter.SplitByNothing(), {"Date"}), {{"Date", type date}}),
				    Year = Table.AddColumn(Base, "Year", each Date.Year([Date]), Int64.Type),
				    Quarter = Table.AddColumn(Year, "Quarter", each "Q" & Text.From(Date.QuarterOfYear([Date])), type text),
				    MonthNumber = Table.AddColumn(Quarter, "Month number", each Date.Month([Date]), Int64.Type),
				    Month = Table.AddColumn(MonthNumber, "Month", each Date.ToText([Date], [Format = "MMM", Culture = "en-US"]), type text),
				    YearMonth = Table.AddColumn(Month, "Year-Month", each Date.ToText([Date], [Format = "yyyy-MM"]), type text),
				    YearMonthNumber = Table.AddColumn(YearMonth, "Year-Month number", each [Year] * 100 + [Month number], Int64.Type),
				    WeekdayNumber = Table.AddColumn(YearMonthNumber, "Weekday number", each Date.DayOfWeek([Date], Day.Monday) + 1, Int64.Type),
				    Weekday = Table.AddColumn(WeekdayNumber, "Weekday", each Date.ToText([Date], [Format = "ddd", Culture = "en-US"]), type text),
				    Weekend = Table.AddColumn(Weekday, "Is weekend", each [Weekday number] > 5, type logical)
				in
				    Weekend

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

