/// One row per incident. A run has at most one. It opens when a guard blocks, would block, flags or strips something.
table Incidents
	lineageTag: 1403ed23-0ac2-4ef4-aa54-3c86d7ee3791

	column 'Opened date'
		dataType: dateTime
		isHidden
		formatString: Long Date
		lineageTag: 8252aa03-5e43-47b6-bb9c-b2d9496341b0
		summarizeBy: none
		sourceColumn: Opened date

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Root cause of the incident, or unknown until the root-cause finder files a verdict.
	column Category
		dataType: string
		lineageTag: 75a627b1-5745-4020-948c-f62057a0350d
		summarizeBy: none
		sourceColumn: Category

		annotation SummarizationSetBy = Automatic

	column 'Damage agent'
		dataType: string
		isHidden
		lineageTag: 9b1441c0-83ce-46d1-8b98-971a237103f7
		summarizeBy: none
		sourceColumn: Damage agent

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Entry agent'
		dataType: string
		isHidden
		lineageTag: 4a2d4ca9-65a5-4206-b620-6b479184d27b
		summarizeBy: none
		sourceColumn: Entry agent

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Turning agent'
		dataType: string
		isHidden
		lineageTag: fc55c7d0-bf78-41d4-91d2-4e5126b29813
		summarizeBy: none
		sourceColumn: Turning agent

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Where the risky content came in, such as web or email.
	column 'Entry origin kind'
		dataType: string
		lineageTag: f58f1b54-2dc1-43cf-aefd-5b2529f3601f
		summarizeBy: none
		sourceColumn: Entry origin kind

		annotation SummarizationSetBy = Automatic

	partition Incidents = m
		mode: import
		source =
				let
				    Source = GetView("fact_incident"),
				    Types = {
				        {"opened_date", type date}, {"category", type text}, {"damage_agent", type text},
				        {"entry_agent", type text}, {"turning_agent", type text}, {"entry_origin_kind", type text}
				    },
				    Kept = Table.SelectColumns(Source, List.Transform(Types, each _{0})),
				    Typed = Table.TransformColumnTypes(Kept, Types),
				    Named = Table.TransformColumnNames(Typed, ColumnName)
				in
				    Named

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

