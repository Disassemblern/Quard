	partition 'Model calls' = m
		mode: import
		source =
				let
				    Source = GetView("fact_model_call"),
				    Types = {
				        {"agent", type text}, {"model", type text}, {"call_date", type date},
				        {"status", type text}, {"input_tokens", Int64.Type}, {"cached_tokens", Int64.Type},
				        {"cost_micro_usd", Int64.Type}, {"duration_ms", Int64.Type}
				    },
				    Kept = Table.SelectColumns(Source, List.Transform(Types, each _{0})),
				    Typed = Table.TransformColumnTypes(Kept, Types),
				    Named = Table.TransformColumnNames(Typed, ColumnName)
				in
				    Named

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

