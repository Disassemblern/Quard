/// One row per payment event, from the challenge to the settlement.
table Payments
	lineageTag: 240ad45e-6c4a-4061-8c7c-0ba9320955b1

	/// Run the payment was made in, to find it in Quard.
	column 'Run ID'
		dataType: string
		lineageTag: 5adbc831-8958-4261-90ab-83ff50b74050
		summarizeBy: none
		sourceColumn: Run ID

		annotation SummarizationSetBy = Automatic

	column Agent
		dataType: string
		isHidden
		lineageTag: e77a00e8-0947-4004-acc0-ef42ae49059d
		summarizeBy: none
		sourceColumn: Agent

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Payment date'
		dataType: dateTime
		isHidden
		formatString: Long Date
		lineageTag: d78d264f-f469-48ef-8c9c-cb35482991d0
		summarizeBy: none
		sourceColumn: Payment date

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// How far the payment got: challenged, refused, signed, settled or failed.
	column Stage
		dataType: string
		lineageTag: a48db01f-c988-467b-ac04-85952ff213df
		summarizeBy: none
		sourceColumn: Stage

		annotation SummarizationSetBy = Automatic

	/// Host the payment was for.
	column Host
		dataType: string
		lineageTag: 140870cd-3531-4de8-9d95-10124ae804f1
		summarizeBy: none
		sourceColumn: Host

		annotation SummarizationSetBy = Automatic

	/// Network the payment was made on.
	column Network
		dataType: string
		lineageTag: 784cef15-0631-4b63-a9f0-2afaf42bf450
		summarizeBy: none
		sourceColumn: Network

		annotation SummarizationSetBy = Automatic

	/// Address the payment went to: the payee.
	column 'Pay to'
		dataType: string
		lineageTag: 9bae2417-c293-4f8a-b48c-d52e966e5c96
		summarizeBy: none
		sourceColumn: Pay to

		annotation SummarizationSetBy = Automatic

	column 'Value micro USD'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 87b0d5e1-896d-45c9-b347-b3da8a341cb8
		summarizeBy: sum
		sourceColumn: Value micro USD

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column Delivered
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 9cecfce7-6d8e-4026-801c-732f5ceafec1
		summarizeBy: none
		sourceColumn: Delivered

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition Payments = m
		mode: import
		source =
				let
				    Source = GetView("fact_payment"),
				    Types = {
				        {"run_id", type text}, {"agent", type text}, {"payment_date", type date},
				        {"stage", type text}, {"host", type text}, {"network", type text}, {"pay_to", type text},
				        {"value_micro_usd", Int64.Type}, {"delivered", type logical}
				    },
				    Kept = Table.SelectColumns(Source, List.Transform(Types, each _{0})),
				    Typed = Table.TransformColumnTypes(Kept, Types),
				    Named = Table.TransformColumnNames(Typed, ColumnName)
				in
				    Named

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

