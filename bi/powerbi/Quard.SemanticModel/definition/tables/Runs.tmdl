/// One row per agent run. Slice by outcome; measures count runs and add up their cost.
table Runs
	lineageTag: 4b149061-461c-4d80-a5c7-4d016bf32af1

	column Agent
		dataType: string
		isHidden
		lineageTag: dbc455e4-fbe7-4b59-8af1-cd3e6d86eea6
		summarizeBy: none
		sourceColumn: Agent

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Start date'
		dataType: dateTime
		isHidden
		formatString: Long Date
		lineageTag: 57573b00-91b2-4f53-b6bf-cd862982dc91
		summarizeBy: none
		sourceColumn: Start date

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// How the run ended, or running if it has not ended yet.
	column Outcome
		dataType: string
		lineageTag: fecc5592-28f3-4fa5-9f37-658031d1a014
		summarizeBy: none
		sourceColumn: Outcome

		annotation SummarizationSetBy = Automatic

	column 'Step count'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5d5d4f8b-7f89-4dd7-902d-61f73ea9a07c
		summarizeBy: sum
		sourceColumn: Step count

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Cost micro USD'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 610695c2-ceb3-44f3-8c8b-df90bbb316e5
		summarizeBy: sum
		sourceColumn: Cost micro USD

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Cost known'
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 8dc09f12-7100-411a-b2ea-8da883979c66
		summarizeBy: none
		sourceColumn: Cost known

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition Runs = m
		mode: import
		source =
				let
				    Source = GetView("fact_run"),
				    Types = {
				        {"agent", type text}, {"start_date", type date}, {"outcome", type text},
				        {"step_count", Int64.Type}, {"cost_micro_usd", Int64.Type}, {"cost_known", type logical}
				    },
				    Kept = Table.SelectColumns(Source, List.Transform(Types, each _{0})),
				    Typed = Table.TransformColumnTypes(Kept, Types),
				    Named = Table.TransformColumnNames(Typed, ColumnName)
				in
				    Named

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Exception

