/// One row per tool call. Its arguments are not stored.
table 'Tool calls'
	lineageTag: fcc1ae4b-b29c-4d03-87f6-b6035df1edad

	column Agent
		dataType: string
		isHidden
		lineageTag: 023d2986-07bc-46e4-9b38-3afb5eb6d2b8
		summarizeBy: none
		sourceColumn: Agent

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column Tool
		dataType: string
		isHidden
		lineageTag: 7f391474-5431-4c65-9239-14a900111085
		summarizeBy: none
		sourceColumn: Tool

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Call date'
		dataType: dateTime
		isHidden
		formatString: Long Date
		lineageTag: a88ee5fc-a062-4258-944c-d723761f3b68
		summarizeBy: none
		sourceColumn: Call date

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Status of the tool call. A call the signature blocked can still show ok; see Reconciliation in bi/README.md.
	column Status
		dataType: string
		lineageTag: 36da2f84-c0f0-4682-bdba-1e12fb69320f
		summarizeBy: none
		sourceColumn: Status

		annotation SummarizationSetBy = Automatic

	column Influenced
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 6983f3c3-135a-43ee-b630-310f3552633f
		summarizeBy: none
		sourceColumn: Influenced

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition 'Tool calls' = m
		mode: import
		source =
				let
				    Source = GetView("fact_tool_call"),
				    Types = {
				        {"agent", type text}, {"tool", type text}, {"call_date", type date}, {"status", type text},
				        {"influenced", type logical}
				    },
				    Kept = Table.SelectColumns(Source, List.Transform(Types, each _{0})),
				    Typed = Table.TransformColumnTypes(Kept, Types),
				    Named = Table.TransformColumnNames(Typed, ColumnName)
				in
				    Named

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

